{
  "name": "argus-claude",
  "displayName": "Argus - Claude Code Agent Monitoring & Observability on VSCode",
  "description": "Monitoring and observability for Claude Code agent sessions inside VS Code — live transcripts, cost telemetry, context-window metrics, dependency graphs, and rule-based analysis of tool calls, retry loops, and compaction events.",
  "version": "0.3.3",
  "publisher": "argus-claude",
  "author": {
    "name": "Ozgur Kurucan",
    "email": "ozgurkurucan337@gmail.com"
  },
  "license": "MIT",
  "icon": "icon-128.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat",
    "Visualization",
    "Debuggers",
    "Data Science",
    "Education"
  ],
  "keywords": [
    "argus",
    "claude",
    "claude-code",
    "claude code",
    "anthropic",
    "agent",
    "ai-agent",
    "agent-monitoring",
    "agent-observability",
    "observability",
    "monitoring",
    "telemetry",
    "tracing",
    "llm",
    "llm-observability",
    "llm-monitoring",
    "session-analysis",
    "session-debugger",
    "transcript",
    "jsonl",
    "tool-calls",
    "subagent",
    "cost-tracking",
    "token-usage",
    "context-window",
    "cache-hit-ratio",
    "performance",
    "analytics",
    "dashboard",
    "developer-tools",
    "vscode-extension"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yessGlory17/argus.git"
  },
  "bugs": {
    "url": "https://github.com/yessGlory17/argus/issues"
  },
  "homepage": "https://github.com/yessGlory17/argus#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "argus",
          "title": "Argus",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "argus": [
        {
          "id": "argusSessionList",
          "name": "Sessions",
          "type": "webview",
          "contextualTitle": "Claude Code Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "argus.refreshSessions",
        "title": "Refresh Sessions",
        "icon": "$(refresh)",
        "category": "Argus"
      },
      {
        "command": "argus.openSessionDetail",
        "title": "Open Session Detail",
        "category": "Argus"
      },
      {
        "command": "argus.openSessionTab",
        "title": "Open Session Tab",
        "category": "Argus"
      },
      {
        "command": "argus.clearFilters",
        "title": "Clear All Filters",
        "icon": "$(clear-all)",
        "category": "Argus"
      },
      {
        "command": "argus.toggleModelOpus",
        "title": "Toggle Opus Filter",
        "category": "Argus"
      },
      {
        "command": "argus.toggleModelSonnet",
        "title": "Toggle Sonnet Filter",
        "category": "Argus"
      },
      {
        "command": "argus.toggleModelHaiku",
        "title": "Toggle Haiku Filter",
        "category": "Argus"
      },
      {
        "command": "argus.setDateAll",
        "title": "All Time",
        "category": "Argus"
      },
      {
        "command": "argus.setDate1h",
        "title": "Last 1 Hour",
        "category": "Argus"
      },
      {
        "command": "argus.setDate3h",
        "title": "Last 3 Hours",
        "category": "Argus"
      },
      {
        "command": "argus.setDate6h",
        "title": "Last 6 Hours",
        "category": "Argus"
      },
      {
        "command": "argus.setDate24h",
        "title": "Last 24 Hours",
        "category": "Argus"
      },
      {
        "command": "argus.setDate7d",
        "title": "Last 7 Days",
        "category": "Argus"
      },
      {
        "command": "argus.setDate30d",
        "title": "Last 30 Days",
        "category": "Argus"
      },
      {
        "command": "argus.setDateCustom",
        "title": "Custom Range...",
        "category": "Argus"
      },
      {
        "command": "argus.setGroupNone",
        "title": "Flat List",
        "category": "Argus"
      },
      {
        "command": "argus.setGroupProject",
        "title": "Group by Project",
        "category": "Argus"
      },
      {
        "command": "argus.setGroupModel",
        "title": "Group by Model",
        "category": "Argus"
      },
      {
        "command": "argus.filterCurrentProjectOn",
        "title": "Show Only Current Project",
        "icon": "$(filter)",
        "category": "Argus"
      },
      {
        "command": "argus.filterCurrentProjectOff",
        "title": "Show Sessions From All Projects",
        "icon": "$(filter-filled)",
        "category": "Argus"
      }
    ],
    "submenus": [
      {
        "id": "argus.groupMenu",
        "label": "Group Sessions",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "submenu": "argus.groupMenu",
          "when": "view == argusSessionList",
          "group": "navigation@1"
        },
        {
          "command": "argus.filterCurrentProjectOn",
          "when": "view == argusSessionList && !argus.filter.currentProject",
          "group": "navigation@2"
        },
        {
          "command": "argus.filterCurrentProjectOff",
          "when": "view == argusSessionList && argus.filter.currentProject",
          "group": "navigation@2"
        },
        {
          "command": "argus.clearFilters",
          "when": "view == argusSessionList && argus.hasActiveFilters",
          "group": "navigation@3"
        },
        {
          "command": "argus.refreshSessions",
          "when": "view == argusSessionList",
          "group": "navigation@4"
        }
      ],
      "argus.groupMenu": [
        {
          "command": "argus.setGroupNone",
          "group": "group@1"
        },
        {
          "command": "argus.setGroupProject",
          "group": "group@2"
        },
        {
          "command": "argus.setGroupModel",
          "group": "group@3"
        }
      ]
    },
    "configuration": {
      "title": "Argus",
      "properties": {
        "argus.scanDepth": {
          "type": "number",
          "default": 5,
          "description": "Maximum directory depth for scanning .claude directories"
        },
        "argus.language": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "tr"
          ],
          "description": "Language for analysis findings"
        },
        "argus.openLocation": {
          "type": "string",
          "default": "active",
          "enum": [
            "active",
            "beside"
          ],
          "enumDescriptions": [
            "Open the session as a tab in the currently active editor group",
            "Open the session in an editor group next to the active one"
          ],
          "description": "Where a session opens when clicked in the Sessions view."
        },
        "argus.delete.useTrash": {
          "type": "boolean",
          "default": true,
          "description": "Move deleted sessions to the system trash so they can be recovered. When the trash is unavailable, Argus asks before deleting permanently instead. Turn this off to delete sessions permanently right away, with a single confirmation."
        },
        "argus.searchBar.showModelSelector": {
          "type": "boolean",
          "default": true,
          "description": "Show the model selector next to the search box in the Sessions view. When turned off the selector is hidden and any active model filter is cleared."
        },
        "argus.steps.sortOrder": {
          "type": "string",
          "default": "newest",
          "enum": [
            "newest",
            "oldest",
            "cost-desc",
            "cost-asc"
          ],
          "enumDescriptions": [
            "Newest step first",
            "Oldest step first",
            "Most expensive step first",
            "Cheapest step first"
          ],
          "description": "Default sort order for the Steps tab of a session. Applied when a session is opened; changing the sort inside a session is temporary."
        },
        "argus.steps.autoExpand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Step types that open expanded in the Steps tab, so their output is visible without clicking. Matched case-insensitively against the tool name (`Read`, `Bash`, `Edit`, …) or step type (`text`, `thinking`), with `*` as a wildcard: `*` expands everything, `mcp*` every MCP tool, `mcp_chromium*` one MCP server (repeated `_` are treated as one, so `mcp_chromium*` also matches `mcp__chromium__navigate`). Clicking a step still toggles it.",
          "examples": [
            [
              "text",
              "thinking"
            ],
            [
              "Read",
              "Bash",
              "mcp*"
            ],
            [
              "*"
            ]
          ]
        },
        "argus.analysis.realCompactsOnly": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Report a `Context Compaction` finding in the Analysis tab only where the transcript actually marks one (`isCompactSummary`). By default the compaction is inferred from a drop in `input + cache_creation` tokens, which also fires on ordinary prompt-cache rotation — a step whose prompt was rewritten into the cache looks identical to a context reset. Enable for accuracy; leave off for transcripts written before Claude Code recorded the marker."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf out",
    "vscode:prepublish": "npm run clean && npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build",
    "dev:webview": "vite",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^8.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.0.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/diff": "^7.0.2",
    "chart.js": "^4.5.1",
    "d3": "^7.9.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.575.0",
    "marked": "^18.0.3",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "recharts": "^3.7.0"
  }
}
